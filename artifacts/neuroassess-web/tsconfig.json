{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@neurocare/permissions": ["../../packages/permissions/src/index.ts"],
      "@neurocare/journey": ["../../packages/journey/src/index.ts"],
      "@neurocare/feature-flags": ["../../packages/feature-flags/src/index.ts"],
      "@neurocare/audit": ["../../packages/audit/src/index.ts"],
      "@neurocare/notifications": ["../../packages/notifications/src/index.ts"],
      "@neurocare/timeline": ["../../packages/timeline/src/index.ts"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
