# NeuroAssess — Railway environment template
# Set these in the Railway dashboard for each environment (development/staging/production).
# Server-only secrets must NEVER be committed.

NODE_ENV=production
NODE_VERSION=24.21.0
PORT=10000

# Browser-safe (baked at build time)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_CLINICIAN_PORTAL_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only secrets (Railway Variables — never committed)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=${{neuroassess-db.DATABASE_URL}}

NEUROCARE_KILL_SWITCH=off
ALLOWED_ORIGINS=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

RESEND_API_KEY=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=

POSTHOG_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
