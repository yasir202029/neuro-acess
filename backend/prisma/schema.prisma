generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PSYCHIATRIST
  PRESCRIBER
  NURSE
  PATIENT
  FINANCE
  CLINICIAN
}
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
enum AssessmentType {
  ADHD
  AUTISM
}
enum AssessmentStatus {
  DRAFT
  INTAKE
  SCREENING
  CLINICAL_REVIEW
  REPORTING
  COMPLETE
  WITHDRAWN
}
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DID_NOT_ATTEND
}
enum AppointmentMode {
  VIDEO
  PHONE
  IN_PERSON
}
enum VideoProvider {
  TEAMS
  ZOOM
}
enum SessionEventType {
  SESSION_CREATED
  WAITING_ROOM_OPENED
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  SESSION_STARTED
  RECORDING_STARTED
  RECORDING_STOPPED
  SESSION_ENDED
}
enum RecordingStatus {
  REQUESTED
  RECORDING
  PROCESSING
  READY
  FAILED
}
enum NoteType {
  CONSULTATION
  PROGRESS
  MEDICATION_REVIEW
  SAFEGUARDING
  PHYSICAL_HEALTH
}
enum DocumentType {
  SCHOOL_REPORT
  BLOOD_TEST
  ECG_RESULT
  GP_LETTER
  PHYSICAL_HEALTH
  ASSESSMENT_FORM
  ASSESSMENT_REPORT
  CLINICAL_LETTER
  SIGNED_PRESCRIPTION
  INVOICE
  ATTACHMENT
  OTHER
}
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
}
enum ServiceLine {
  ADHD_ASSESSMENT
  AUTISM_ASSESSMENT
  FOLLOW_UP
  MEDICATION_REVIEW
  REPORT
  PRESCRIPTION
  OTHER
}
enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
  DEFAULTED
}
enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}
enum RevenueEventType {
  PAYMENT_RECEIVED
  REFUND_ISSUED
  INVOICE_VOIDED
  CLINICIAN_EARNING_ACCRUED
}
enum MetricGranularity {
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum MessageChannel {
  EMAIL
  SMS
  IN_APP
}
enum MessageStatus {
  QUEUED
  SENT
  FAILED
}
enum NotificationType {
  APPOINTMENT_REMINDER
  REPORT_READY
  PAYMENT_UPDATE
  DOCUMENT_MISSING
  TASK_ASSIGNED
}
enum MfaMethod {
  TOTP
  EMAIL
}
enum MfaChallengeType {
  EMAIL_LOGIN
  EMAIL_ENROLLMENT
}
enum SecurityAlertType {
  NEW_DEVICE
  LOGIN_FAILURES
  PASSWORD_CHANGED
  MFA_CHANGED
  ACCOUNT_LOCKED
  SUSPICIOUS_LOGIN
}
enum ScreeningInstrument {
  ASRS
  WURS
  DIVA
  PHQ9
  GAD7
  AQ50
  RAADS_R
  CAT_Q
  INFORMANT_FORM
  DEVELOPMENTAL_HISTORY
}
enum WorkflowEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  COMPLETED
}
enum TitrationStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}
enum PrescriptionStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  SENT
  DISPENSED
  DELIVERED
  CANCELLED
}
enum ShipmentStatus {
  CREATED
  TRACKING_ASSIGNED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}
enum TaskType {
  PENDING_NOTE
  PENDING_REPORT
  PENDING_PRESCRIPTION
  MISSING_DOCUMENT
  ADMIN
}
enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum FeedbackType {
  RATING
  FFT
  NPS
  COMMENT
}
enum ComplaintStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}
enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum AiRunType {
  TRANSCRIPTION
  SPEAKER_SEPARATION
  SUMMARY
  ACTION_ITEMS
  RISK_FLAGS
  NOTE_DRAFT
  REPORT_DRAFT
  LETTER_DRAFT
  MESSAGE_SUGGESTION
  MESSAGE_SUMMARY
}
enum AiRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}
enum AiDocumentType {
  ADHD_REPORT
  AUTISM_REPORT
  FOLLOW_UP_REPORT
  MEDICATION_REVIEW_REPORT
  GP_LETTER
  SHARED_CARE_LETTER
  CONSULTATION_NOTE
}
enum ReportKind {
  ADHD_INITIAL
  ADHD_FOLLOW_UP
  ADHD_TITRATION
  ADHD_SHARED_CARE
  ADHD_DISCHARGE
  AUTISM_ASSESSMENT
  AUTISM_DEVELOPMENTAL_HISTORY
  AUTISM_INFORMANT
  AUTISM_DIAGNOSTIC
  GP_LETTER
  SHARED_CARE_LETTER
  SCHOOL_LETTER
  EMPLOYER_LETTER
  SUPPORTING_EVIDENCE_LETTER
}
enum ReportStatus {
  DRAFT
  REVIEW_REQUIRED
  APPROVED
  SHARED
  ARCHIVED
}
enum AiTransformAction {
  GENERATE
  REWRITE
  EXPAND
  SHORTEN
  IMPROVE_GRAMMAR
  GP_FORMAT
  PATIENT_FRIENDLY
}
enum ConsentType {
  DATA_PROCESSING
  RECORDING
  AI_TRANSCRIPTION
  DOCUMENT_SHARING
  SHARED_CARE
}
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}
enum TeamType {
  ASSESSMENT
  TITRATION
  PRESCRIBING
  NURSING
  ADMINISTRATION
  FINANCE
  CLINICAL_GOVERNANCE
}
enum PatientAssignmentRole {
  LEAD_CLINICIAN
  ASSESSMENT_CLINICIAN
  TITRATION_CLINICIAN
  PRESCRIBER
  NURSE
  ADMINISTRATOR
}
enum WorkflowStage {
  REFERRAL
  ADMIN_TRIAGE
  ASSESSMENT
  DIAGNOSIS
  MORE_INFORMATION_REQUIRED
  ECG_REQUESTED
  ASSESSMENT_REVIEW
  TITRATION
  PRESCRIBING
  SHARED_CARE
  DISCHARGE
  OUTCOME
  DIAGNOSIS_NOT_CONFIRMED
}
enum TeamQueueType {
  AWAITING_ASSESSMENT
  AWAITING_REPORT
  AWAITING_INFORMATION
  AWAITING_MEDICATION_START
  ACTIVE_TITRATION
  MEDICATION_REVIEW_DUE
  PRESCRIPTION_AWAITING_APPROVAL
  PRESCRIPTION_AWAITING_SIGNATURE
  CONTROLLED_DRUG_REVIEW
  PHYSICAL_HEALTH_REVIEW
  SIDE_EFFECT_MONITORING
  MISSING_DOCUMENT
  APPOINTMENT_BOOKING
  INVOICE_ISSUE
}
enum TeamQueueStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}
enum CoverStatus {
  PLANNED
  ACTIVE
  RETURNED
  CANCELLED
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([role, permissionId])
  @@index([role])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  role      Role
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([role, revokedAt])
}

model Team {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  type          TeamType
  active        Boolean             @default(true)
  members       TeamMember[]
  assignments   PatientAssignment[]
  queueItems    TeamQueueItem[]
  transitions   WorkflowTransition[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId, active])
}

model PatientAssignment {
  id           String                @id @default(cuid())
  patientId    String
  userId       String
  teamId       String
  role         PatientAssignmentRole
  isPrimary    Boolean               @default(true)
  active       Boolean               @default(true)
  startsAt     DateTime              @default(now())
  endsAt       DateTime?
  reason       String?
  assignedById String?
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user         User                  @relation("AssignmentUser", fields: [userId], references: [id])
  team         Team                  @relation(fields: [teamId], references: [id])
  assignedBy   User?                 @relation("AssignmentGrantor", fields: [assignedById], references: [id])
  cover        CoverArrangement[]
  @@index([patientId, role, active])
  @@index([teamId, active])
  @@unique([patientId, role, userId, startsAt])
}

model WorkflowTransition {
  id          String         @id @default(cuid())
  patientId   String
  teamId      String?
  actorId     String?
  fromStage   WorkflowStage?
  toStage     WorkflowStage
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  team        Team?          @relation(fields: [teamId], references: [id])
  actor       User?          @relation("WorkflowActor", fields: [actorId], references: [id])
  @@index([patientId, createdAt])
  @@index([teamId, toStage, createdAt])
}

model TeamQueueItem {
  id           String          @id @default(cuid())
  patientId    String
  teamId       String
  assignedToId String?
  type         TeamQueueType
  status       TeamQueueStatus @default(OPEN)
  priority     Int             @default(0)
  title        String
  dueAt        DateTime?
  metadata     Json?
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  team         Team            @relation(fields: [teamId], references: [id])
  assignedTo   User?           @relation("QueueAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@index([teamId, status, priority, dueAt])
  @@index([patientId, status])
}

model CoverArrangement {
  id                   String                @id @default(cuid())
  patientId            String
  patientAssignmentId  String
  originalUserId       String
  coveringUserId       String
  status               CoverStatus           @default(PLANNED)
  startsAt             DateTime
  endsAt               DateTime?
  reason               String?
  notificationSentAt   DateTime?
  returnedAt           DateTime?
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientAssignment    PatientAssignment    @relation(fields: [patientAssignmentId], references: [id])
  originalUser         User                  @relation("OriginalClinicianCover", fields: [originalUserId], references: [id])
  coveringUser         User                  @relation("CoverClinician", fields: [coveringUserId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  @@index([coveringUserId, status, startsAt])
  @@index([originalUserId, status, endsAt])
  @@index([patientId, status])
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  status             UserStatus   @default(ACTIVE)
  roles              Role[]
  roleAssignments    UserRole[]
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean      @default(false)
  mfaFactors         MfaFactor[]
  sessions           UserSession[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  mfaChallenges      MfaChallenge[]
  devices            Device[]
  loginHistory       LoginHistory[]
  securityAlerts     SecurityAlert[]
  patient            Patient?
  clinician          Clinician?
  sentMessages       Message[]    @relation("MessageSender")
  notifications      Notification[]
  auditEvents        AuditEvent[] @relation("AuditActor")
  assignedTasks      ClinicalTask[] @relation("TaskAssignee")
  noteVersions       ClinicalNoteVersion[] @relation("NoteVersionAuthor")
  uploadedVersions   DocumentVersion[] @relation("DocumentVersionUploader")
  documentAccesses   DocumentAccessLog[] @relation("DocumentAccessActor")
  reviewedAiDocs     AiGeneratedDocument[] @relation("AiReviewer")
  reportVersions     ReportVersion[] @relation("ReportVersionAuthor")
  reportAudits       ReportAuditEvent[] @relation("ReportAuditActor")
  assignedComplaints Complaint[]  @relation("ComplaintAssignee")
  teamMemberships    TeamMember[]
  patientAssignments PatientAssignment[] @relation("AssignmentUser")
  grantedAssignments PatientAssignment[] @relation("AssignmentGrantor")
  originalCover      CoverArrangement[] @relation("OriginalClinicianCover")
  coveringPatients   CoverArrangement[] @relation("CoverClinician")
  workflowActions    WorkflowTransition[] @relation("WorkflowActor")
  queueAssignments   TeamQueueItem[] @relation("QueueAssignee")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model MfaFactor {
  id           String    @id @default(cuid())
  userId       String
  method       MfaMethod
  secretCipher String
  label        String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, method])
  @@index([userId, method])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String?
  refreshTokenId String? @unique
  ipAddress    String?
  userAgent    String?
  lastSeenAt   DateTime @default(now())
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  @@index([userId, revokedAt])
}

model RefreshToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String       @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   UserSession?
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model MfaChallenge {
  id          String             @id @default(cuid())
  userId      String
  type        MfaChallengeType
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                @default(0)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}

model Device {
  id            String    @id @default(cuid())
  userId        String
  fingerprintHash String
  label         String?
  platform      String?
  userAgent     String?
  ipAddress     String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  trustedAt     DateTime?
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      UserSession[]
  loginHistory  LoginHistory[]
  @@unique([userId, fingerprintHash])
  @@index([userId, revokedAt, lastSeenAt])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  success       Boolean
  reason        String?
  ipAddress     String?
  userAgent     String?
  deviceId      String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device        Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([email, success, createdAt])
}

model SecurityAlert {
  id             String            @id @default(cuid())
  userId         String?
  type           SecurityAlertType
  title          String
  message        String
  metadata       Json?
  acknowledgedAt DateTime?
  createdAt      DateTime          @default(now())
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, acknowledgedAt, createdAt])
}

model Patient {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  nhsNumberCipher       String?
  nhsNumberHash         String?                @unique
  dateOfBirth           DateTime?
  sexAtBirth            String?
  gender                String?
  address               Json?
  emergencyContact      Json?
  preferredContact      String?
  consentToContact      Boolean                @default(false)
  medicalHistory        String?
  currentMedication     Json?
  accessibilityNeeds    String?
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts              PatientContact[]
  assessments           Assessment[]
  appointments          Appointment[]
  documents             Document[]
  invoices              Invoice[]
  messageThreads        MessageThread[]
  screeningResponses    ScreeningResponse[]
  physicalReviews       PhysicalHealthReview[]
  prescriptions         Prescription[]
  feedback              Feedback[]
  complaints            Complaint[]
  notes                 ClinicalNote[]
  sharedCareAgreements  SharedCareAgreement[]
  revenueEvents         RevenueEvent[]
  consentRecords        ConsentRecord[]
  recordingConsents     RecordingConsent[]
  reports               Report[]
  assignments           PatientAssignment[]
  workflowTransitions   WorkflowTransition[]
  queueItems            TeamQueueItem[]
  coverArrangements     CoverArrangement[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model PatientContact {
  id           String   @id @default(cuid())
  patientId    String
  type         String
  name         String
  relationship String?
  phone        String?
  email        String?
  address      Json?
  isEmergency  Boolean  @default(false)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([patientId, isEmergency])
}

model Clinician {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  registrationBody   String
  registrationNumber String
  specialisms        String[]
  active             Boolean                @default(true)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments        Assessment[]
  appointments       Appointment[]
  availability       Availability[]
  notes              ClinicalNote[]
  physicalReviews    PhysicalHealthReview[]
  prescriptions      Prescription[]
  titrationPlans     TitrationPlan[]
  sharedCarePlans    SharedCareAgreement[]
  assignedTasks      ClinicalTask[]         @relation("ClinicianTaskAssignee")
  earnings           ClinicianEarning[]
  revenueEvents      RevenueEvent[]
  reports            Report[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  @@unique([registrationBody, registrationNumber])
}

model Availability {
  id          String          @id @default(cuid())
  clinicianId String
  startsAt    DateTime
  endsAt      DateTime
  mode        AppointmentMode
  booked      Boolean         @default(false)
  clinician   Clinician       @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  appointment Appointment?
  @@index([clinicianId, startsAt])
}

model Appointment {
  id                 String              @id @default(cuid())
  patientId          String
  clinicianId        String?
  availabilityId     String?             @unique
  type               AssessmentType
  status             AppointmentStatus   @default(REQUESTED)
  mode               AppointmentMode
  startsAt           DateTime
  endsAt             DateTime
  cancellationReason String?
  patient            Patient             @relation(fields: [patientId], references: [id])
  clinician          Clinician?          @relation(fields: [clinicianId], references: [id])
  availability       Availability?       @relation(fields: [availabilityId], references: [id])
  videoSession       VideoSession?
  notes              ClinicalNote[]
  attendance         AttendanceRecord?
  statusEvents       AppointmentStatusEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([patientId, startsAt])
  @@index([clinicianId, startsAt])
}

model AppointmentStatusEvent {
  id            String            @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  reason        String?
  createdAt     DateTime          @default(now())
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@index([appointmentId, createdAt])
}

model VideoSession {
  id                String             @id @default(cuid())
  appointmentId     String             @unique
  provider          VideoProvider
  providerSessionId String?
  joinUrl           String?
  clinicianJoinUrl  String?
  waitingRoomOpenedAt DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  recordingEnabled  Boolean            @default(false)
  recordingUrl      String?
  appointment       Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recordingConsents RecordingConsent[]
  recording         Recording?
  events            VideoSessionEvent[]
  aiSession         AiSession?
}

model VideoSessionEvent {
  id            String          @id @default(cuid())
  videoSessionId String
  type          SessionEventType
  participantRole String?
  participantId String?
  metadata      Json?
  occurredAt    DateTime        @default(now())
  videoSession  VideoSession    @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  @@index([videoSessionId, occurredAt])
}

model Recording {
  id                String          @id @default(cuid())
  videoSessionId    String          @unique
  providerRecordingId String?
  status            RecordingStatus @default(REQUESTED)
  storageBucket     String?
  storagePath       String?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  videoSession      VideoSession    @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model AttendanceRecord {
  id              String      @id @default(cuid())
  appointmentId   String      @unique
  patientJoinedAt DateTime?
  clinicianJoinedAt DateTime?
  patientLeftAt   DateTime?
  clinicianLeftAt DateTime?
  patientPresent  Boolean     @default(false)
  clinicianPresent Boolean    @default(false)
  missedReason    String?
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model RecordingConsent {
  id           String       @id @default(cuid())
  patientId    String
  videoSessionId String
  consented    Boolean
  consentText  String
  recordedAt   DateTime     @default(now())
  patient      Patient      @relation(fields: [patientId], references: [id])
  videoSession VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  @@unique([patientId, videoSessionId])
}

model Assessment {
  id              String                @id @default(cuid())
  patientId       String
  clinicianId     String?
  type            AssessmentType
  status          AssessmentStatus      @default(DRAFT)
  startedAt       DateTime?
  completedAt     DateTime?
  formulation     String?
  recommendations Json?
  patient         Patient               @relation(fields: [patientId], references: [id])
  clinician       Clinician?            @relation(fields: [clinicianId], references: [id])
  adhd            AdhdAssessment?
  autism          AutismAssessment?
  screenings      ScreeningResponse[]
  workflowEvents  AssessmentWorkflowEvent[]
  documents       Document[]
  aiDocuments     AiGeneratedDocument[]
  reports         Report[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  @@index([patientId, type, status])
}

model AssessmentWorkflowEvent {
  id           String              @id @default(cuid())
  assessmentId String
  type         WorkflowEventType
  fromStatus   AssessmentStatus?
  toStatus     AssessmentStatus?
  metadata     Json?
  createdAt    DateTime            @default(now())
  assessment   Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, createdAt])
}

model ScreeningResponse {
  id            String             @id @default(cuid())
  patientId     String
  assessmentId  String?
  instrument    ScreeningInstrument
  formKey       String
  version       String
  answers       Json
  score         Decimal?           @db.Decimal(8, 2)
  submittedAt   DateTime?
  patient       Patient            @relation(fields: [patientId], references: [id])
  assessment    Assessment?        @relation(fields: [assessmentId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@index([patientId, instrument])
  @@index([assessmentId, instrument])
}

model AdhdAssessment {
  id                 String          @id @default(cuid())
  assessmentId       String          @unique
  symptomProfile     Json?
  impairmentProfile  Json?
  assessment         Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  titrationPlans     TitrationPlan[]
  medicationReviews  MedicationReview[]
}

model AutismAssessment {
  id                    String     @id @default(cuid())
  assessmentId          String     @unique
  communicationProfile  Json?
  sensoryProfile        Json?
  developmentalHistory  Json?
  informantDetails      Json?
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model TitrationPlan {
  id              String          @id @default(cuid())
  adhdAssessmentId String
  clinicianId     String
  status          TitrationStatus @default(PLANNED)
  targetMedication String?
  startDate       DateTime?
  endDate         DateTime?
  reviewIntervalDays Int?
  adhdAssessment  AdhdAssessment  @relation(fields: [adhdAssessmentId], references: [id], onDelete: Cascade)
  clinician       Clinician       @relation(fields: [clinicianId], references: [id])
  reviews         TitrationReview[]
  @@index([clinicianId, status])
}

model TitrationReview {
  id              String        @id @default(cuid())
  titrationPlanId String
  reviewDate      DateTime
  dose            String?
  response        String?
  sideEffects     String?
  bloodPressure   String?
  pulse           Int?
  weightKg       Decimal?       @db.Decimal(6, 2)
  nextReviewAt    DateTime?
  titrationPlan   TitrationPlan  @relation(fields: [titrationPlanId], references: [id], onDelete: Cascade)
  @@index([titrationPlanId, reviewDate])
}

model MedicationReview {
  id              String         @id @default(cuid())
  adhdAssessmentId String
  medication      String
  dose            String?
  reviewedAt      DateTime?
  response        String?
  sideEffects     String?
  nextReviewAt    DateTime?
  adhdAssessment  AdhdAssessment @relation(fields: [adhdAssessmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
}

model SharedCareAgreement {
  id            String    @id @default(cuid())
  patientId     String
  clinicianId   String
  gpName        String?
  gpPractice    String?
  status        String
  startDate     DateTime?
  reviewDate    DateTime?
  documentId    String?   @unique
  patient       Patient   @relation(fields: [patientId], references: [id])
  clinician     Clinician @relation(fields: [clinicianId], references: [id])
  document      Document? @relation(fields: [documentId], references: [id])
  createdAt     DateTime  @default(now())
}

model PhysicalHealthReview {
  id             String       @id @default(cuid())
  patientId      String
  clinicianId    String?
  reviewDate     DateTime     @default(now())
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  pulse          Int?
  weightKg       Decimal?     @db.Decimal(6, 2)
  heightCm       Decimal?     @db.Decimal(6, 2)
  bmi            Decimal?     @db.Decimal(5, 2)
  sleepHours     Decimal?     @db.Decimal(4, 2)
  appetite       String?
  sideEffects    String?
  notes          String?
  patient        Patient      @relation(fields: [patientId], references: [id])
  clinician      Clinician?   @relation(fields: [clinicianId], references: [id])
  alerts         PhysicalHealthAlert[]
  @@index([patientId, reviewDate])
}

model PhysicalHealthAlert {
  id          String               @id @default(cuid())
  reviewId    String
  metric      String
  severity    AuditSeverity
  message     String
  acknowledgedAt DateTime?
  review      PhysicalHealthReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
}

model ClinicalNote {
  id            String        @id @default(cuid())
  patientId     String
  clinicianId   String
  appointmentId String?
  type          NoteType
  content       String
  signedAt      DateTime?
  patient       Patient       @relation(fields: [patientId], references: [id])
  clinician     Clinician     @relation(fields: [clinicianId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  versions      ClinicalNoteVersion[]
  attachments   Document[]
  aiSource      AiGeneratedDocument?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([patientId, createdAt])
}

model ClinicalNoteVersion {
  id        String        @id @default(cuid())
  noteId    String
  version   Int
  content   String
  authorId  String
  createdAt DateTime      @default(now())
  note      ClinicalNote  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author    User          @relation("NoteVersionAuthor", fields: [authorId], references: [id])
  @@unique([noteId, version])
}

model Document {
  id              String                @id @default(cuid())
  patientId       String
  assessmentId    String?
  noteId          String?
  type            DocumentType
  name            String
  mimeType        String
  sizeBytes       Int
  checksum        String?
  currentVersion  Int                   @default(1)
  invoiceId       String?               @unique
  prescriptionId  String?               @unique
  patient         Patient               @relation(fields: [patientId], references: [id])
  assessment      Assessment?           @relation(fields: [assessmentId], references: [id])
  note            ClinicalNote?         @relation(fields: [noteId], references: [id])
  versions        DocumentVersion[]
  accessLogs      DocumentAccessLog[]
  sharedCare      SharedCareAgreement?
  invoice         Invoice?              @relation("InvoiceDocument", fields: [invoiceId], references: [id])
  prescription    Prescription?         @relation("PrescriptionDocument", fields: [prescriptionId], references: [id])
  courierProof    CourierShipment?      @relation("CourierProof")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  @@index([patientId, type, createdAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  storageProvider String @default("supabase")
  storageBucket String
  storagePath  String
  encryptionKeyRef String?
  uploadedById String
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("DocumentVersionUploader", fields: [uploadedById], references: [id])
  @@unique([documentId, version])
}

model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  actorId    String
  action     String
  ipAddress  String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor      User     @relation("DocumentAccessActor", fields: [actorId], references: [id])
  @@index([documentId, createdAt])
}

model Prescription {
  id                 String             @id @default(cuid())
  patientId          String
  clinicianId        String
  status             PrescriptionStatus @default(DRAFT)
  issuedAt           DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  repeatRequestedAt  DateTime?
  patient            Patient            @relation(fields: [patientId], references: [id])
  clinician          Clinician          @relation(fields: [clinicianId], references: [id])
  items              PrescriptionItem[]
  document           Document?           @relation("PrescriptionDocument")
  statusEvents       PrescriptionStatusEvent[]
  shipments          CourierShipment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  @@index([patientId, status])
  @@index([clinicianId, status])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medication     String
  strength       String?
  dose           String?
  quantity       String?
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PrescriptionStatusEvent {
  id             String             @id @default(cuid())
  prescriptionId String
  status         PrescriptionStatus
  metadata       Json?
  createdAt      DateTime           @default(now())
  prescription   Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([prescriptionId, createdAt])
}

model CourierShipment {
  id             String         @id @default(cuid())
  prescriptionId String
  courierName    String?
  trackingId     String?
  status         ShipmentStatus @default(CREATED)
  qrCodeValue    String?        @unique
  proofDocumentId String?       @unique
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id])
  proofDocument  Document?      @relation("CourierProof", fields: [proofDocumentId], references: [id])
  events         CourierEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CourierEvent {
  id          String          @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  occurredAt  DateTime
  rawPayload  Json?
  shipment    CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  @@index([shipmentId, occurredAt])
}

model AiSession {
  id              String       @id @default(cuid())
  videoSessionId  String       @unique
  consented       Boolean      @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  videoSession    VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  runs            AiRun[]
  transcript      AiTranscript?
  summary         AiSummary?
  extraction      AiExtraction?
  @@index([startedAt])
}

model AiSummary {
  id                String   @id @default(cuid())
  aiSessionId       String   @unique
  consultationNotes String?
  adhdSummary       String?
  autismSummary     String?
  followUpNotes     String?
  gpLetter          String?
  sharedCareLetter  String?
  draftReport       String?
  aiSession         AiSession @relation(fields: [aiSessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AiExtraction {
  id             String   @id @default(cuid())
  aiSessionId    String   @unique
  actionItems    Json?
  riskFlags      Json?
  diagnoses      Json?
  medications    Json?
  physicalHealth Json?
  aiSession      AiSession @relation(fields: [aiSessionId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiTranscript {
  id          String          @id @default(cuid())
  aiSessionId String          @unique
  language    String          @default("en-GB")
  storagePath String?
  aiSession   AiSession       @relation(fields: [aiSessionId], references: [id], onDelete: Cascade)
  segments    AiTranscriptSegment[]
  createdAt   DateTime        @default(now())
}

model AiTranscriptSegment {
  id           String        @id @default(cuid())
  transcriptId String
  speaker      String?
  content      String
  startsAtMs   Int
  endsAtMs     Int
  transcript   AiTranscript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  @@index([transcriptId, startsAtMs])
}

model AiRun {
  id            String       @id @default(cuid())
  aiSessionId   String
  type          AiRunType
  status        AiRunStatus  @default(QUEUED)
  model         String?
  promptVersion String?
  inputHash     String?
  output        Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  aiSession     AiSession    @relation(fields: [aiSessionId], references: [id], onDelete: Cascade)
  generatedDocuments AiGeneratedDocument[]
  createdAt     DateTime     @default(now())
  @@index([aiSessionId, type, createdAt])
}

model AiGeneratedDocument {
  id           String          @id @default(cuid())
  assessmentId String?
  noteId       String?         @unique
  reviewerId   String?
  type         AiDocumentType
  title        String
  content      String
  version      Int             @default(1)
  status       AiRunStatus     @default(REVIEW_REQUIRED)
  sourceRunId  String?
  assessment   Assessment?     @relation(fields: [assessmentId], references: [id])
  note         ClinicalNote?   @relation(fields: [noteId], references: [id])
  reviewer     User?           @relation("AiReviewer", fields: [reviewerId], references: [id])
  sourceRun    AiRun?          @relation(fields: [sourceRunId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@index([assessmentId, type, status])
}

model ReportTemplate {
  id              String                 @id @default(cuid())
  key             String                 @unique
  name            String
  kind            ReportKind
  description     String?
  active          Boolean                @default(true)
  versions        ReportTemplateVersion[]
  reports         Report[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  @@index([kind, active])
}

model ReportTemplateVersion {
  id            String        @id @default(cuid())
  templateId    String
  version       Int
  content       String
  systemPrompt  String?
  promptVersion String?
  createdAt     DateTime      @default(now())
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  @@unique([templateId, version])
}

model Report {
  id             String          @id @default(cuid())
  patientId      String
  assessmentId   String?
  clinicianId    String?
  templateId     String?
  kind           ReportKind
  status         ReportStatus    @default(DRAFT)
  title          String
  currentVersion Int             @default(1)
  patient        Patient         @relation(fields: [patientId], references: [id])
  assessment     Assessment?     @relation(fields: [assessmentId], references: [id])
  clinician      Clinician?      @relation(fields: [clinicianId], references: [id])
  template       ReportTemplate? @relation(fields: [templateId], references: [id])
  versions       ReportVersion[]
  aiOutputs      AiOutput[]
  auditEvents    ReportAuditEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([patientId, kind, status])
  @@index([clinicianId, status, updatedAt])
}

model ReportVersion {
  id          String    @id @default(cuid())
  reportId    String
  version     Int
  content     String
  createdById String?
  aiOutputId  String?   @unique
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("ReportVersionAuthor", fields: [createdById], references: [id])
  aiOutput    AiOutput? @relation("ReportVersionOutput", fields: [aiOutputId], references: [id])
  createdAt   DateTime  @default(now())
  @@unique([reportId, version])
}

model AiOutput {
  id            String             @id @default(cuid())
  reportId      String?
  type          AiRunType
  action        AiTransformAction  @default(GENERATE)
  model         String
  promptVersion String
  inputSnapshot Json?
  outputContent String
  status        AiRunStatus        @default(REVIEW_REQUIRED)
  report        Report?            @relation(fields: [reportId], references: [id])
  reportVersion ReportVersion?     @relation("ReportVersionOutput")
  createdAt     DateTime           @default(now())
  @@index([reportId, action, createdAt])
}

model ReportAuditEvent {
  id         String   @id @default(cuid())
  reportId   String
  actorId    String?
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor      User?    @relation("ReportAuditActor", fields: [actorId], references: [id])
  @@index([reportId, createdAt])
}

model MessageThread {
  id          String       @id @default(cuid())
  patientId   String
  subject     String?
  priority    String       @default("normal")
  patient     Patient      @relation(fields: [patientId], references: [id])
  messages    Message[]
  aiSuggestions AiMessageSuggestion[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([patientId, updatedAt])
}

model Message {
  id          String        @id @default(cuid())
  threadId    String
  senderId    String?
  channel     MessageChannel
  status      MessageStatus @default(QUEUED)
  body        String
  sentAt      DateTime?
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User?         @relation("MessageSender", fields: [senderId], references: [id])
  createdAt   DateTime      @default(now())
  @@index([threadId, createdAt])
}

model AiMessageSuggestion {
  id          String        @id @default(cuid())
  threadId    String
  content     String
  tone        String?
  urgency     String?
  status      AiRunStatus   @default(REVIEW_REQUIRED)
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  @@index([userId, readAt, createdAt])
}

model Invoice {
  id              String        @id @default(cuid())
  patientId       String
  number          String        @unique
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("gbp")
  subtotalPence   Int
  totalPence      Int
  serviceLine     ServiceLine   @default(OTHER)
  dueAt           DateTime?
  failedAttempts  Int           @default(0)
  stripeInvoiceId String?       @unique
  patient         Patient       @relation(fields: [patientId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  paymentPlan     PaymentPlan?
  refunds         Refund[]
  revenueEvents   RevenueEvent[]
  document        Document?     @relation("InvoiceDocument")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([patientId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  amountPence Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amountPence     Int
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  providerEventId String?       @unique
  failureCode     String?
  failureMessage  String?
  paidAt          DateTime?
  reconciledAt    DateTime?
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  refunds         Refund[]
  revenueEvents   RevenueEvent[]
  createdAt       DateTime      @default(now())
}

model ClinicianEarning {
  id             String     @id @default(cuid())
  clinicianId    String
  periodStart    DateTime
  periodEnd      DateTime
  appointments   Int        @default(0)
  assessments    Int        @default(0)
  reviews        Int        @default(0)
  reports        Int        @default(0)
  prescriptions  Int        @default(0)
  amountPence    Int        @default(0)
  paidAmountPence Int       @default(0)
  dueAmountPence  Int       @default(0)
  serviceBreakdown Json?
  clinician      Clinician  @relation(fields: [clinicianId], references: [id])
  createdAt      DateTime   @default(now())
  @@unique([clinicianId, periodStart, periodEnd])
}

model PaymentPlan {
  id          String            @id @default(cuid())
  invoiceId   String            @unique
  status      PaymentPlanStatus @default(ACTIVE)
  installmentCount Int
  intervalDays Int
  invoice     Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments PaymentPlanInstallment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model PaymentPlanInstallment {
  id            String        @id @default(cuid())
  paymentPlanId String
  sequence      Int
  amountPence   Int
  dueAt         DateTime
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  stripePaymentId String?
  paymentPlan   PaymentPlan   @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  @@unique([paymentPlanId, sequence])
  @@index([dueAt, status])
}

model Refund {
  id              String       @id @default(cuid())
  invoiceId       String
  paymentId       String?
  amountPence     Int
  status          RefundStatus @default(REQUESTED)
  reason          String?
